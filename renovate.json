{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "customManagers": [
    {
      "description": "Tool versions pinned as a workflow env var or action input. actionlint and zizmor install an exact version instead of the release page's `latest`, so the pin has to be something Renovate can see. extractVersionTemplate drops the tag's leading v to match how the version is written in the file.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[\\w-]+: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge GitHub Actions patch/digest (low risk)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    }
  ]
}
