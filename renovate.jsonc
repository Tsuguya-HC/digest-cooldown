{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // The aqua preset is pinned rather than floating: it owns which files the aqua
  // manager reads, and a preset-side change would silently re-scope this repo.
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>aquaproj/aqua-renovate-config#2.13.0"
  ],

  "minimumReleaseAge": "3 days",

  // Merge directly rather than queueing on GitHub: this repo has no required checks
  // that platform automerge would wait on, and queueing just delays the merge.
  "platformAutomerge": false,

  "customManagers": [
    {
      "description": [
        "zizmor's version input, pinned so the action resolves a digest-pinned",
        "container instead of `latest`. Every other CLI in the workflows comes from",
        "aqua.yaml now, which the aqua preset handles. extractVersionTemplate drops",
        "the tag's leading v to match how the version is written in the file."
      ],
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[\\w-]+: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],

  "packageRules": [
    {
      "description": [
        "First-party code does not soak. minimumReleaseAge buys time for someone",
        "else to notice a poisoned release before we take it; there is no someone",
        "else here — we wrote it, reviewed it and merged it. Waiting three days on",
        "our own reusable workflow only delays fixes to the thing that gates every",
        "other check."
      ],
      "matchPackageNames": ["Tsuguya/**"],
      "minimumReleaseAge": "0"
    },
    {
      "description": [
        "A digest has no release date attached (renovate#38656), so the age gate",
        "cannot be evaluated and renovate/stability-days is set but never clears.",
        "horenso#22 — a plain node:22-alpine digest pin — sat pending on exactly",
        "this for 84 days. digest-cooldown gates these on its own clock instead."
      ],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": "0"
    },
    {
      // This repo is the cooldown gate the other repos depend on, but its own
      // action bumps are ordinary CI updates — the gate does not gate itself.
      "description": "Automerge GitHub Actions patch/digest (low risk)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    }
  ]
}
